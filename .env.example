# Copy to .env and fill in before running `docker compose up -d --build`.

# The domain this app is served from (must have DNS A/AAAA pointed at this VPS).
DOMAIN=ytpd.example.com

# Long random string used to sign JWTs. Generate with: openssl rand -base64 48
JWT_SECRET=

# Login credentials for the app itself.
AUTH_USERNAME=admin

# Generate with (after `docker compose build api`):
#   docker compose run --rm api hash-password 'your-password-here'
AUTH_PASSWORD_HASH=
