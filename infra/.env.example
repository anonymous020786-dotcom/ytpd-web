# Real values live only in /opt/ytpd/.env on the EC2 instance (written via
# SSM, never committed - see ../README.md "deploying the app").

# Supabase Postgres connection string for the ytpd_app role (not the
# postgres superuser - see ../README.md for why a dedicated role exists).
#
# Uses the Supavisor *pooler* host (aws-0-<region>.pooler.supabase.com),
# NOT db.<project-ref>.supabase.co directly - the direct hostname resolves
# to an IPv6-only address, and this EC2 instance's VPC has no outbound
# IPv6 route ("Network is unreachable" - hit and confirmed live). The
# pooler is IPv4-compatible on every Supabase tier. Session mode (port
# 5432, not 6543) matches this app's long-lived connection pattern.
# Username must be "<role>.<project-ref>", not just "<role>", for the
# pooler to route to the right project.
POSTGRES_CONNECTION_STRING=Host=aws-0-ap-south-1.pooler.supabase.com;Port=5432;Database=postgres;Username=ytpd_app.hgeswxsxnzhfrzkqytuu;Password=REPLACE_ME;SSL Mode=Require;Trust Server Certificate=true

# Long random string, signs JWTs. Generate with: openssl rand -base64 48
JWT_SECRET=REPLACE_ME

# Login credentials for the hosted app (web/mobile/bot clients - desktop
# uses its own local-mode bypass instead, see AuthController.cs).
AUTH_USERNAME=REPLACE_ME
# Output of: dotnet YtpdWeb.Api.dll hash-password '<password>'
AUTH_PASSWORD_HASH=REPLACE_ME

# Cloudflare Tunnel token for the ytpd-web tunnel (see ../tunnel_token.tmp)
TUNNEL_TOKEN=REPLACE_ME
